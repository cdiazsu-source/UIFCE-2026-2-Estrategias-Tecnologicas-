# Copia este archivo a .env y completa con tu cadena de conexión real de Neon.
# En Neon: Dashboard del proyecto -> Connection string (usa la que incluye "?sslmode=require").
DATABASE_URL="postgresql://usuario:password@ep-xxxx.neon.tech/et_centro_de_mando?sslmode=require"

# --- Acceso al sitio (login compartido, dos perfiles, mismo usuario) ---
# Opcionales: valores por defecto entre paréntesis.
#   SITE_PASSWORD        -> perfil completo, edita todo         ("ET2026")
#   SITE_PASSWORD_JUNIOR -> perfil junior, solo agrega notas    ("TEAM")
# En Vercel conviene fijar contraseñas y AUTH_SECRET propios (Project -> Settings
# -> Environment Variables). AUTH_SECRET firma la cookie: cualquier cadena larga
# y aleatoria sirve.
SITE_USER="UIFCE"
SITE_PASSWORD="ET2026"
SITE_PASSWORD_JUNIOR="TEAM"
AUTH_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
