generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  POR_INICIAR
  EN_CURSO
  COMPLETADO
}

enum ToolStatus {
  ACTIVA
  VENCIDA
  SIN_LICENCIA
  GRATUITA
}

/// Una iniciativa de planeacion_del_area.csv. El id coincide con la
/// columna ID del CSV (slug estable, ver src/build_planeacion_2026_2_v2.py).
/// Los campos de contenido (title/description/expectedOutcome/rationale) se
/// resincronizan desde el CSV; status y driveFolderUrl solo se editan aquí.
model Project {
  id              String        @id
  category        String
  priorityTag     String?
  title           String
  description     String        @db.Text
  expectedOutcome String        @db.Text
  rationale       String        @db.Text
  status          ProjectStatus @default(POR_INICIAR)
  driveFolderUrl  String?
  /// Orden de la fila en el CSV, para mantener el orden original en la UI.
  sourceOrder     Int           @unique

  checklistItems ChecklistItem[]
  notes          ProjectNote[]
  contacts       Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Subtarea del checklist de un proyecto. Se siembra una sola vez desde las
/// viñetas de la columna Entregables del CSV y luego vive de forma
/// independiente: un resync solo agrega ítems nuevos, nunca sobrescribe.
model ChecklistItem {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String    @db.Text
  order     Int
  done      Boolean   @default(false)
  assignee  String?
  dueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Entrada de bitácora de un proyecto.
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  author    String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

/// Datos fijos de la franja "situación actual" del panel principal.
/// Editables manualmente, no se recalculan solos.
model SituationStat {
  id        String   @id @default(cuid())
  label     String
  value     String
  order     Int      @unique
  updatedAt DateTime @updatedAt
}

/// Fila de la tabla de Herramientas y licencias.
model Tool {
  id             String     @id @default(cuid())
  name           String
  status         ToolStatus @default(SIN_LICENCIA)
  location       String?
  lastVerifiedAt DateTime?
  notes          String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Fila del directorio de contactos.
model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String
  email     String?
  phone     String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}
