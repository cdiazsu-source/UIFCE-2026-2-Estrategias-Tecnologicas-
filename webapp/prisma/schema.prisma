generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  POR_INICIAR
  EN_CURSO
  COMPLETADO
}

enum ToolStatus {
  ACTIVA
  VENCIDA
  SIN_LICENCIA
  GRATUITA
}

/// Rol de una persona del equipo o de su entorno cercano. El directorio de
/// `User` es editable in-app; por ahora no hay inicio de sesión.
/// EQUIPO representa al área entera ("Estrategias Tecnológicas (ET)") como
/// responsable posible de una subtarea que no recae en una sola persona.
enum UserRole {
  MASTER
  JUNIOR_ARTES
  JUNIOR_AUXILIAR
  COORDINADOR
  DIRECTOR
  EQUIPO
}

/// Estado de cada punto de corte de un proyecto de estudio.
enum CheckpointStatus {
  PENDIENTE
  EN_CURSO
  CUMPLIDO
  ATRASADO
}

/// Plataforma de una cuenta institucional en el panel de Redes sociales.
enum SocialPlatform {
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  FACEBOOK
}

/// Estado operativo de una cuenta en el panel de Redes sociales.
enum SocialChannelStatus {
  ACTIVA
  EN_RIESGO
  EN_TRAMITE
  INACTIVA
  PERDIDA
}

/// Estado de oficialización de una cuenta ante la Oficina de Medios Digitales UNAL.
enum SocialOfficialStatus {
  OFICIALIZADA
  EN_TRAMITE
  SIN_OFICIALIZAR
}

/// Semestre de planeación. Los proyectos se agrupan por semestre; los
/// objetivos del área también viven aquí. Uno está marcado como el vigente.
model Semester {
  id         String   @id @default(cuid())
  /// Etiqueta visible, ej. "2026-2S".
  label      String   @unique
  /// Objetivos del área para ese semestre (uno por elemento).
  objectives String[] @default([])
  /// true = semestre vigente (el que se muestra por defecto). Solo uno.
  isCurrent  Boolean  @default(false)
  order      Int      @default(0)

  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Una iniciativa de planeacion_del_area.csv. El id coincide con la
/// columna ID del CSV (slug estable, ver src/build_planeacion_2026_2_v2.py).
/// Los campos de contenido (title/description/expectedOutcome/rationale) se
/// resincronizan desde el CSV; status y driveFolderUrl solo se editan aquí.
model Project {
  id              String        @id
  category        String
  priorityTag     String?
  title           String
  description     String        @db.Text
  expectedOutcome String        @db.Text
  rationale       String        @db.Text
  status          ProjectStatus @default(POR_INICIAR)
  driveFolderUrl  String?
  /// Etiquetas libres del proyecto, editables desde la app.
  tags            String[]      @default([])
  /// Semestre al que pertenece. El resync desde el CSV solo lo fija al crear.
  semesterId      String?
  semester        Semester?     @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  /// Orden de la fila en el CSV, para mantener el orden original en la UI.
  /// Los proyectos creados a mano toman sourceOrder >= 1000 (ver
  /// src/lib/actions/projects.ts) para no chocar con el índice del CSV.
  sourceOrder     Int           @unique
  /// true = creado desde la app, no viene del CSV. El resync por seed lo ignora.
  isManual        Boolean       @default(false)
  /// true = alguien editó el contenido (título/descripción/…) desde la app.
  /// El resync desde el CSV deja de sobrescribir esos campos para no perder
  /// la edición; el CSV sigue mandando el orden (sourceOrder).
  editedInApp     Boolean       @default(false)

  checklistItems ChecklistItem[]
  notes          ProjectNote[]
  contacts       Contact[]
  socialChannels SocialChannel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semesterId])
}

/// Subtarea del checklist de un proyecto. Se siembra una sola vez desde las
/// viñetas de la columna Entregables del CSV y luego vive de forma
/// independiente: un resync solo agrega ítems nuevos, nunca sobrescribe.
model ChecklistItem {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String    @db.Text
  order     Int
  done      Boolean   @default(false)
  /// Snapshot del nombre del responsable (se conserva si el User cambia/desaparece).
  assignee  String?
  /// Vínculo al User responsable, si existe. Da el color de la persona.
  assigneeId String?
  assigneeUser User?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate   DateTime?

  /// Notas de bitácora que se refieren específicamente a esta subtarea.
  notes     ProjectNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

/// Entrada de bitácora de un proyecto. Solo la escribe alguien del equipo
/// (se elige de la lista de User); se guarda un snapshot de nombre y cargo
/// para que la nota histórica no cambie si el User se edita o se elimina.
model ProjectNote {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  /// Snapshot del nombre de quien la escribió.
  author     String
  /// Snapshot del cargo (rol) al momento de escribir.
  authorRole String?
  /// Vínculo al User que la escribió, si sigue existiendo.
  authorId   String?
  authorUser User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Subtarea del checklist a la que se refiere la nota, si el autor la vinculó.
  /// Al borrar la subtarea la nota queda como nota general del proyecto.
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
  @@index([authorId])
  @@index([checklistItemId])
}

/// Datos fijos de la franja "situación actual" del panel principal.
/// Editables manualmente, no se recalculan solos.
model SituationStat {
  id        String   @id @default(cuid())
  label     String
  value     String
  order     Int      @unique
  updatedAt DateTime @updatedAt
}

/// Fila de la tabla de Herramientas y licencias.
model Tool {
  id             String     @id @default(cuid())
  name           String
  status         ToolStatus @default(SIN_LICENCIA)
  location       String?
  lastVerifiedAt DateTime?
  notes          String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Fila del directorio de contactos.
model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String
  email     String?
  phone     String?
  /// Nombre de archivo de la foto en webapp/public/avatares/ (ej. "sandra-vargas.jpg")
  /// o URL completa. Si está vacío, la UI muestra las iniciales.
  photoUrl  String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Persona del equipo de ET o de su entorno cercano (coordinación, dirección).
/// Directorio editable desde /equipo. `email` es la identidad; por ahora no
/// habilita inicio de sesión — es sólo dato de contacto y atribución.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  /// Área a la que pertenece ("ET"); null para coordinación/dirección transversal.
  area      String?
  /// Nombre de archivo de la foto en webapp/public/avatares/ o URL completa.
  /// Si está vacío, la UI muestra las iniciales. Mismo criterio que Contact.photoUrl.
  photoUrl  String?
  /// Color de acento de la persona (#RRGGBB) para identificar de un vistazo sus
  /// actividades (subtareas, proyectos de estudio). Si está vacío se deriva del id.
  color     String?
  active    Boolean  @default(true)
  /// Clave de identidad de su credencial de acceso propia, si tiene una
  /// (ver src/lib/auth.ts). Hoy solo el director.
  credentialKey String? @unique
  /// Última vez que esa persona entró al aplicativo con su credencial propia.
  lastSeenAt    DateTime?

  studyProjects        StudyProject[]
  projectNotes         ProjectNote[]
  assignedChecklistItems ChecklistItem[]
  socialChannels       SocialChannel[]
  teamComments         TeamComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Comentario o idea que cualquiera del equipo deja en el panel principal para
/// que se revise después. El autor se elige de la lista de User (equipo).
model TeamComment {
  id         String   @id @default(cuid())
  body       String   @db.Text
  /// Snapshot del nombre y cargo de quien lo dejó.
  author     String
  authorRole String?
  authorId   String?
  authorUser User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// true = ya lo revisó alguien del equipo.
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([authorId])
}

/// Una plantilla reutilizable del área, agrupada por categoría (redes sociales,
/// televisores, difusión por correo, disponibilidad de salas, Cursos Libres,
/// eventos, apoyos académicos, …). Editable desde /plantillas.
model Template {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?  @db.Text
  /// Enlace a la plantilla (Drive, Canva, Figma, documento…).
  url         String?
  /// Formato o medida, ej. "Reel 1080×1920", "Correo HTML", "Póster A3".
  format      String?
  notes       String?  @db.Text
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Una cuenta institucional (Instagram, LinkedIn, X, …) en el panel de Redes
/// sociales: estado operativo, última publicación, cadencia objetivo y quién la
/// gestiona. Una fila por plataforma.
model SocialChannel {
  id            String              @id @default(cuid())
  platform      SocialPlatform      @unique
  /// Nombre de usuario público, ej. "@uifce_un".
  handle        String?
  /// Enlace al perfil.
  url           String?
  status        SocialChannelStatus @default(ACTIVA)
  /// Estado de oficialización ante la Oficina de Medios Digitales de la UNAL.
  officialStatus SocialOfficialStatus @default(SIN_OFICIALIZAR)
  /// Seguidores (se actualiza a mano; no se calcula).
  followers     Int?
  /// Cadencia objetivo de publicación, ej. "1 reel por semana".
  cadence       String?
  /// Fecha de la última publicación registrada.
  lastPostAt    DateTime?
  /// Qué fue la última publicación.
  lastPostNote  String?             @db.Text
  /// Próximo paso o pendiente de la cuenta.
  nextAction    String?             @db.Text
  notes         String?             @db.Text
  responsibleId String?
  responsible   User?               @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order         Int                 @default(0)

  interactions  SocialInteraction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responsibleId])
  @@index([projectId])
}

/// Una interacción o hito relevante de una cuenta de redes, con fecha, para
/// darle trazabilidad en el tiempo (publicación destacada, mención, salto de
/// seguidores, cambio de estrategia…). Se agrega a mano y no se borra sola.
model SocialInteraction {
  id           String        @id @default(cuid())
  channelId    String
  channel      SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Fecha en que ocurrió (no necesariamente cuando se registró).
  at           DateTime
  /// Qué pasó, en una línea.
  title        String
  /// Detalle opcional.
  detail       String?       @db.Text
  /// Foto de números en esa fecha (opcionales, se llenan a mano).
  followers    Int?
  reach        Int?
  interactions Int?
  url          String?

  createdAt DateTime @default(now())

  @@index([channelId, at])
}

/// Proyecto de estudio de un monitor Junior. Cada Junior expone dos por semestre.
/// El cronograma es texto libre; el seguimiento formal son los 4 puntos de corte.
model StudyProject {
  id          String   @id @default(cuid())
  title       String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  description String?   @db.Text
  /// Cronograma en texto libre (hitos, fechas, entregas parciales).
  schedule    String?   @db.Text
  /// Enlace a la carpeta de Drive donde el Junior sube los entregables.
  driveFolderUrl String?
  order       Int       @default(0)

  checkpoints StudyCheckpoint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// Uno de los 4 puntos de corte de un proyecto de estudio. Se crean los 4 al
/// crear el proyecto (number 1..4) y sólo se editan fecha, estado y notas.
model StudyCheckpoint {
  id             String           @id @default(cuid())
  studyProject   StudyProject     @relation(fields: [studyProjectId], references: [id], onDelete: Cascade)
  studyProjectId String
  number         Int
  label          String
  dueDate        DateTime?
  status         CheckpointStatus @default(PENDIENTE)
  notes          String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyProjectId, number])
  @@index([studyProjectId])
}

/// Un bloque de la guía de línea gráfica (colores, franjas, formatos,
/// lineamientos de Imagen Institucional / Unimedios). Editable desde /linea-grafica.
model BrandGuideline {
  id        String   @id @default(cuid())
  /// Agrupador: "Colores", "Franjas", "Formatos", "Lineamientos".
  section   String
  title     String
  body      String   @db.Text
  /// Color en hex (#RRGGBB) si el bloque describe un color; muestra un swatch.
  colorHex  String?
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}
