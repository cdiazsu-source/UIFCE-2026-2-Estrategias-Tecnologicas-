generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  POR_INICIAR
  EN_CURSO
  COMPLETADO
}

enum ToolStatus {
  ACTIVA
  VENCIDA
  SIN_LICENCIA
  GRATUITA
}

/// Rol de una persona del equipo o de su entorno cercano. El directorio de
/// `User` es editable in-app; por ahora no hay inicio de sesión.
/// EQUIPO representa al área entera ("Estrategias Tecnológicas (ET)") como
/// responsable posible de una subtarea que no recae en una sola persona.
enum UserRole {
  MASTER
  JUNIOR_ARTES
  JUNIOR_AUXILIAR
  COORDINADOR
  DIRECTOR
  EQUIPO
  LIDER
}

/// Estado de cada punto de corte de un proyecto de estudio.
enum CheckpointStatus {
  PENDIENTE
  EN_CURSO
  CUMPLIDO
  ATRASADO
}

/// Plataforma de una cuenta institucional en el panel de Redes sociales.
enum SocialPlatform {
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  FACEBOOK
}

/// Estado operativo de una cuenta en el panel de Redes sociales.
enum SocialChannelStatus {
  ACTIVA
  EN_RIESGO
  EN_TRAMITE
  INACTIVA
  PERDIDA
}

/// Estado de oficialización de una cuenta ante la Oficina de Medios Digitales UNAL.
enum SocialOfficialStatus {
  OFICIALIZADA
  EN_TRAMITE
  SIN_OFICIALIZAR
}

/// Ficha institucional del área (singleton, id fijo "area"): descripción
/// corporativa y objetivos generales/permanentes. Los objetivos por semestre
/// viven en Semester.objectives.
model AreaProfile {
  id          String   @id @default("area")
  description String   @db.Text
  objectives  String[] @default([])
  updatedAt   DateTime @updatedAt
}

/// Semestre de planeación. Los proyectos se agrupan por semestre; los
/// objetivos de cada semestre también viven aquí. Uno está marcado como vigente.
model Semester {
  id         String   @id @default(cuid())
  /// Etiqueta visible, ej. "2026-2S".
  label      String   @unique
  /// Objetivos del área para ese semestre (uno por elemento).
  objectives String[] @default([])
  /// true = semestre vigente (el que se muestra por defecto). Solo uno.
  isCurrent  Boolean  @default(false)
  order      Int      @default(0)

  projects      Project[]
  studyProjects StudyProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Una iniciativa de planeacion_del_area.csv. El id coincide con la
/// columna ID del CSV (slug estable, ver src/build_planeacion_2026_2_v2.py).
/// Los campos de contenido (title/description/expectedOutcome/rationale) se
/// resincronizan desde el CSV; status y driveFolderUrl solo se editan aquí.
model Project {
  id              String        @id
  category        String
  priorityTag     String?
  title           String
  description     String        @db.Text
  expectedOutcome String        @db.Text
  rationale       String        @db.Text
  status          ProjectStatus @default(POR_INICIAR)
  driveFolderUrl  String?
  /// Etiquetas libres del proyecto, editables desde la app.
  tags            String[]      @default([])
  /// Semestre al que pertenece. El resync desde el CSV solo lo fija al crear.
  semesterId      String?
  semester        Semester?     @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  /// Orden de la fila en el CSV, para mantener el orden original en la UI.
  /// Los proyectos creados a mano toman sourceOrder >= 1000 (ver
  /// src/lib/actions/projects.ts) para no chocar con el índice del CSV.
  sourceOrder     Int           @unique
  /// true = creado desde la app, no viene del CSV. El resync por seed lo ignora.
  isManual        Boolean       @default(false)
  /// true = alguien editó el contenido (título/descripción/…) desde la app.
  /// El resync desde el CSV deja de sobrescribir esos campos para no perder
  /// la edición; el CSV sigue mandando el orden (sourceOrder).
  editedInApp     Boolean       @default(false)
  /// Persona responsable del proyecto (asignación a nivel de proyecto, aparte de
  /// los responsables de cada subtarea). Da el color del proyecto en el panel.
  assigneeId      String?
  assignee        User?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Fecha/hora de inicio y fin, solo para proyectos que son (o incluyen) un
  /// evento con horario concreto. Alimenta /horario; la mayoría de proyectos
  /// se quedan en null (sin horario fijo).
  startAt         DateTime?
  endAt           DateTime?
  /// Lugar del evento (salón, edificio, aforo…), texto libre.
  location        String?
  /// Proyecto "principal" del que esta fila es una actividad/parte, ej. cada
  /// actividad de la Semana UIFCE cuelga del proyecto "Semana UIFCE". Si el
  /// principal se borra, esta fila queda suelta (no se borra en cascada).
  mainProjectId   String?
  mainProject     Project?        @relation("ProjectMain", fields: [mainProjectId], references: [id], onDelete: SetNull)
  relatedProjects Project[]       @relation("ProjectMain")

  checklistItems ChecklistItem[]
  notes          ProjectNote[]
  contacts       Contact[]
  socialChannels SocialChannel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semesterId])
  @@index([assigneeId])
  @@index([mainProjectId])
  @@index([startAt])
}

/// Subtarea del checklist de un proyecto. Se siembra una sola vez desde las
/// viñetas de la columna Entregables del CSV y luego vive de forma
/// independiente: un resync solo agrega ítems nuevos, nunca sobrescribe.
model ChecklistItem {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String    @db.Text
  order     Int
  done      Boolean   @default(false)
  /// Snapshot del nombre del responsable (se conserva si el User cambia/desaparece).
  assignee  String?
  /// Vínculo al User responsable, si existe. Da el color de la persona.
  assigneeId String?
  assigneeUser User?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate   DateTime?
  /// Ids de personas del equipo etiquetadas/mencionadas en esta subtarea
  /// (además del responsable). Sin FK: un id que ya no exista se ignora al mostrar.
  mentionIds String[] @default([])

  /// Notas de bitácora que se refieren específicamente a esta subtarea.
  notes     ProjectNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

/// Entrada de bitácora de un proyecto. Solo la escribe alguien del equipo
/// (se elige de la lista de User); se guarda un snapshot de nombre y cargo
/// para que la nota histórica no cambie si el User se edita o se elimina.
model ProjectNote {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  /// Snapshot del nombre de quien la escribió.
  author     String
  /// Snapshot del cargo (rol) al momento de escribir.
  authorRole String?
  /// Vínculo al User que la escribió, si sigue existiendo.
  authorId   String?
  authorUser User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// Subtarea del checklist a la que se refiere la nota, si el autor la vinculó.
  /// Al borrar la subtarea la nota queda como nota general del proyecto.
  checklistItemId String?
  checklistItem   ChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  /// Ids de personas del equipo etiquetadas/mencionadas en la nota. Sin FK.
  mentionIds String[] @default([])
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
  @@index([authorId])
  @@index([checklistItemId])
}

/// Datos fijos de la franja "situación actual" del panel principal.
/// Editables manualmente, no se recalculan solos.
model SituationStat {
  id        String   @id @default(cuid())
  label     String
  value     String
  order     Int      @unique
  updatedAt DateTime @updatedAt
}

/// Nombre/etiqueta de un equipo puntual de una sala de cómputo (ej. "UIFCE-09"),
/// en la disposición interactiva de Herramientas y licencias. Solo se crea la
/// fila cuando alguien le pone nombre a ese puesto; si no tiene fila, la UI
/// muestra solo su número.
model LabSeat {
  id        String   @id @default(cuid())
  /// "sala1" | "sala2" | "sala3".
  room      String
  /// Número del puesto dentro de la sala (1..N); 0 = el tablero/proyector.
  number    Int
  name      String?
  /// Claves de software con licencia confirmada en este equipo (ver SOFTWARE
  /// en lab-room-preview.tsx), ej. ["excel", "r"].
  software  String[] @default([])
  /// Qué tiene puesto de fondo/protector de pantalla ahora mismo: cada equipo
  /// (y el tablero, que es un proyector) es una vitrina publicitaria de la
  /// unidad — QR a Linktree, redes, aplicativos, página web.
  wallpaper String?
  /// true = esta fila no es un puesto físico sino el tablero/proyector de la
  /// sala (número 0), que también se puede alimentar desde cualquier equipo.
  isProjector Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([room, number])
  @@index([room])
}

/// Fila de la tabla de Herramientas y licencias.
model Tool {
  id             String     @id @default(cuid())
  name           String
  status         ToolStatus @default(SIN_LICENCIA)
  location       String?
  lastVerifiedAt DateTime?
  notes          String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Fila del directorio de contactos.
model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String
  email     String?
  phone     String?
  /// Nombre de archivo de la foto en webapp/public/avatares/ (ej. "sandra-vargas.jpg")
  /// o URL completa. Si está vacío, la UI muestra las iniciales.
  photoUrl  String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  notes     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

/// Persona del equipo de ET o de su entorno cercano (coordinación, dirección).
/// Directorio editable desde /equipo. `email` es la identidad; por ahora no
/// habilita inicio de sesión — es sólo dato de contacto y atribución.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole
  /// Área a la que pertenece ("ET"); null para coordinación/dirección transversal.
  area      String?
  /// Nombre de archivo de la foto en webapp/public/avatares/ o URL completa.
  /// Si está vacío, la UI muestra las iniciales. Mismo criterio que Contact.photoUrl.
  photoUrl  String?
  /// Color de acento de la persona (#RRGGBB) para identificar de un vistazo sus
  /// actividades (subtareas, proyectos de estudio). Si está vacío se deriva del id.
  color     String?
  active    Boolean  @default(true)
  /// Enlace al perfil de LinkedIn personal de la persona.
  linkedinUrl String?
  /// Clave de identidad de su credencial de acceso propia, si tiene una
  /// (ver NAMED_CREDENTIALS en src/lib/auth.ts): hoy el director, Lina y Santi.
  credentialKey String? @unique
  /// Última vez que esa persona entró al aplicativo con su credencial propia.
  lastSeenAt    DateTime?

  studyProjects        StudyProject[]
  projectNotes         ProjectNote[]
  assignedProjects     Project[]
  assignedChecklistItems ChecklistItem[]
  socialChannels       SocialChannel[]
  socialMetrics        SocialMetric[]
  linkedInTrackees     LinkedInTrackee[]
  linkedInSnapshots    LinkedInSnapshot[]
  consentSignatures    ConsentSignatory[]
  teamComments         TeamComment[]
  studyProjectComments StudyProjectComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Comentario o idea que cualquiera del equipo deja en el panel principal para
/// que se revise después. El autor se elige de la lista de User (equipo).
model TeamComment {
  id         String   @id @default(cuid())
  body       String   @db.Text
  /// Snapshot del nombre y cargo de quien lo dejó.
  author     String
  authorRole String?
  authorId   String?
  authorUser User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  /// true = ya lo revisó alguien del equipo.
  reviewed   Boolean  @default(false)
  /// Comentario al que responde esta fila, si es una respuesta. Un solo nivel de
  /// anidado: al responder a una respuesta, se cuelga del comentario raíz. Si se
  /// borra el comentario padre, sus respuestas quedan como comentarios sueltos.
  parentId   String?
  parent     TeamComment?  @relation("TeamCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies    TeamComment[] @relation("TeamCommentReplies")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([authorId])
  @@index([parentId])
}

/// Una plantilla reutilizable del área, agrupada por categoría (redes sociales,
/// televisores, difusión por correo, disponibilidad de salas, Cursos Libres,
/// eventos, apoyos académicos, …). Editable desde /plantillas.
model Template {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?  @db.Text
  /// Enlace a la plantilla (Drive, Canva, Figma, documento…).
  url         String?
  /// Formato o medida, ej. "Reel 1080×1920", "Correo HTML", "Póster A3".
  format      String?
  notes       String?  @db.Text
  /// Captura de pantalla / miniatura de la pieza. Normalmente una data URL con
  /// la imagen ya reducida (~640px) que pega quien edita; también admite un
  /// enlace o un archivo en /public. Se muestra como vista previa en la tarjeta.
  screenshot  String?  @db.Text
  order       Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Una cuenta institucional (Instagram, LinkedIn, X, …) en el panel de Redes
/// sociales: estado operativo, última publicación, cadencia objetivo y quién la
/// gestiona. Una fila por plataforma.
model SocialChannel {
  id            String              @id @default(cuid())
  platform      SocialPlatform      @unique
  /// Nombre de usuario público, ej. "@uifce_un".
  handle        String?
  /// Enlace al perfil.
  url           String?
  status        SocialChannelStatus @default(ACTIVA)
  /// Estado de oficialización ante la Oficina de Medios Digitales de la UNAL.
  officialStatus SocialOfficialStatus @default(SIN_OFICIALIZAR)
  /// Seguidores (se actualiza a mano; no se calcula).
  followers     Int?
  /// Cadencia objetivo de publicación, ej. "1 reel por semana".
  cadence       String?
  /// Fecha de la última publicación registrada.
  lastPostAt    DateTime?
  /// Qué fue la última publicación.
  lastPostNote  String?             @db.Text
  /// Próximo paso o pendiente de la cuenta.
  nextAction    String?             @db.Text
  notes         String?             @db.Text
  responsibleId String?
  responsible   User?               @relation(fields: [responsibleId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  order         Int                 @default(0)

  interactions  SocialInteraction[]
  metrics       SocialMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([responsibleId])
  @@index([projectId])
}

/// Una interacción o hito relevante de una cuenta de redes, con fecha, para
/// darle trazabilidad en el tiempo (publicación destacada, mención, salto de
/// seguidores, cambio de estrategia…). Se agrega a mano y no se borra sola.
model SocialInteraction {
  id           String        @id @default(cuid())
  channelId    String
  channel      SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Fecha en que ocurrió (no necesariamente cuando se registró).
  at           DateTime
  /// Qué pasó, en una línea.
  title        String
  /// Detalle opcional.
  detail       String?       @db.Text
  /// Foto de números en esa fecha (opcionales, se llenan a mano).
  followers    Int?
  reach        Int?
  interactions Int?
  url          String?

  createdAt DateTime @default(now())

  @@index([channelId, at])
}

/// Medición de KPIs de una cuenta de redes en una fecha concreta. La registra
/// alguien del equipo (perfil junior o completo) para llevar la evolución de las
/// métricas en el tiempo. Los campos son específicos por plataforma: en cada
/// fila se llenan solo los de la cuenta correspondiente (Instagram o LinkedIn).
model SocialMetric {
  id        String        @id @default(cuid())
  channelId String
  channel   SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  /// Se copia de la cuenta al registrar; evita un join para filtrar por red.
  platform  SocialPlatform
  /// Fecha a la que corresponde la medición (no necesariamente cuándo se cargó).
  at        DateTime
  /// Quién registró la medición. Se elige de la lista de equipo (el perfil
  /// junior compartido no lleva identidad propia). Snapshot del nombre aparte.
  recordedById   String?
  recordedByUser User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByName String?
  note      String?       @db.Text

  // --- Instagram ---
  igFollowers     Int?
  igReach         Int?
  igImpressions   Int?
  igInteractions  Int?
  igProfileVisits Int?

  // --- LinkedIn ---
  liFollowers         Int?
  liProfileViews      Int?
  liPostImpressions   Int?
  liInteractions      Int?
  liSearchAppearances Int?

  createdAt DateTime @default(now())

  @@index([channelId, at])
  @@index([recordedById])
}

/// Una persona a la que se le hace seguimiento de LinkedIn (marca empleadora de
/// la UIFCE). Lista curada (se define en el seed y se ajusta en Redes → LinkedIn),
/// separada del directorio de `User` para no llenar los desplegables del resto
/// de la app. `userId` la enlaza opcionalmente a una persona del directorio
/// (para reusar su foto y color). Las métricas de la PÁGINA institucional viven
/// en SocialChannel/SocialMetric (canal LINKEDIN), no aquí, para no medir lo
/// mismo en dos lugares.
model LinkedInTrackee {
  id          String  @id @default(cuid())
  name        String
  linkedinUrl String?
  /// Área de la UIFCE (código libre: "ET", "CL", "GC"…). Editable en la app.
  area        String?
  /// Nivel: direction / coordination / lead / master / junior. Editable.
  level       String?
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Int     @default(0)
  active      Boolean @default(true)

  snapshots LinkedInSnapshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Medición mensual de LinkedIn de una persona (`LinkedInTrackee`). Una fila por
/// trackee y mes ("YYYY-MM"). Entrada manual, sin API.
model LinkedInSnapshot {
  id        String          @id @default(cuid())
  trackeeId String
  trackee   LinkedInTrackee @relation(fields: [trackeeId], references: [id], onDelete: Cascade)
  month     String

  profileScore     Int?
  connections      Int?
  followers        Int?
  ssi              Int?
  postsLast30      Int?
  engagementLast30 Int?
  recommendations  Int?
  certsPublished   Int?
  uifceExperience  Boolean @default(false)
  creatorMode      Boolean @default(false)

  note           String?  @db.Text
  recordedById   String?
  recordedByUser User?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedByName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([trackeeId, month])
  @@index([trackeeId, month])
  @@index([recordedById])
}

/// Estado de firma del consentimiento de uso de imagen para el micrositio
/// (proyecto "consentimiento-imagen-micrositio"). Una fila por integrante de la
/// UIFCE: si firmó el documento y si ya se le dio acceso a su carpeta de fotos
/// en Drive. Lista curada, aparte del directorio de `User` (`userId` la enlaza
/// opcionalmente para reusar foto y color).
model ConsentSignatory {
  id            String    @id @default(cuid())
  name          String
  signed        Boolean   @default(false)
  signedAt      DateTime?
  driveAccess   Boolean   @default(false)
  driveAccessAt DateTime?
  /// Carpeta de Drive con las fotos de esa persona (destino del botón).
  driveFolderUrl String?
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Int       @default(0)
  active        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Proyecto de estudio de un monitor Junior. Cada Junior expone dos por semestre.
/// El cronograma es texto libre; el seguimiento formal son los 4 puntos de corte.
model StudyProject {
  id          String   @id @default(cuid())
  title       String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  description String?   @db.Text
  /// Cronograma en texto libre (hitos, fechas, entregas parciales).
  schedule    String?   @db.Text
  /// Enlace a la carpeta de Drive donde el Junior sube los entregables.
  driveFolderUrl String?
  order       Int       @default(0)
  /// Semestre al que pertenece; se muestra agrupado por semestre en el panel.
  semesterId  String?
  semester    Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)

  checkpoints StudyCheckpoint[]
  comments    StudyProjectComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([semesterId])
}

/// Actualización, pregunta o dificultad que el dueño de un proyecto de estudio
/// (o coordinación/máster, con una sugerencia) deja sobre ESE proyecto en
/// particular. Como el login es compartido (sin cuenta por persona), quién
/// "puede comentar" se controla igual que en TeamComment: el desplegable
/// "¿Quién eres?" solo ofrece Users con rol Junior/Coordinación/Máster (ver
/// lib/actions/study-comments.ts), y la acción valida el rol otra vez server-side.
/// Las respuestas (parentId) son la vía para que coordinación/máster sugieran
/// algo sobre la actualización de un Junior; un solo nivel de anidado, igual
/// que TeamComment.
model StudyProjectComment {
  id             String   @id @default(cuid())
  studyProjectId String
  studyProject   StudyProject @relation(fields: [studyProjectId], references: [id], onDelete: Cascade)
  body           String   @db.Text
  /// Snapshot del nombre y cargo de quien lo dejó.
  author         String
  authorRole     String?
  authorId       String?
  authorUser     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId       String?
  parent         StudyProjectComment?  @relation("StudyProjectCommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies        StudyProjectComment[] @relation("StudyProjectCommentReplies")
  createdAt      DateTime @default(now())

  @@index([studyProjectId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
}

/// Uno de los 4 puntos de corte de un proyecto de estudio. Se crean los 4 al
/// crear el proyecto (number 1..4) y sólo se editan fecha, estado y notas.
model StudyCheckpoint {
  id             String           @id @default(cuid())
  studyProject   StudyProject     @relation(fields: [studyProjectId], references: [id], onDelete: Cascade)
  studyProjectId String
  number         Int
  label          String
  dueDate        DateTime?
  status         CheckpointStatus @default(PENDIENTE)
  notes          String?          @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studyProjectId, number])
  @@index([studyProjectId])
}

/// Un bloque de la guía de línea gráfica (colores, franjas, formatos,
/// lineamientos de Imagen Institucional / Unimedios). Editable desde /linea-grafica.
model BrandGuideline {
  id        String   @id @default(cuid())
  /// Agrupador: "Colores", "Franjas", "Formatos", "Lineamientos".
  section   String
  title     String
  body      String   @db.Text
  /// Color en hex (#RRGGBB) si el bloque describe un color; muestra un swatch.
  colorHex  String?
  order     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([section])
}
